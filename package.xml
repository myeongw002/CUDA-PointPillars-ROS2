  <version>0.1.0</version>
  <description>ROS 2 Humble wrapper for CUDA/TensorRT PointPillars inference.</description>

  <maintainer email="117157396+myeongw002@users.noreply.github.com">myeongw002</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
